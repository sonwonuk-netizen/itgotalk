# Signs the login cookie. Required in production.
SESSION_SECRET=change-me
# Protects POST /api/cron/reports (14-day parent report job).
CRON_SECRET=change-me
# Public base URL used in parent report links (optional; defaults to the request host).
APP_URL=http://localhost:3000
# Local embedded Postgres directory (default .data/pglite). "memory" = in-RAM.
ITGO_DATA_DIR=.data/pglite
